{
  "name": "@comet-speedtest/config",
  "version": "0.2.0",
  "description": "Runtime config defaults, validation, normalization, loading, and export helpers for Comet.",
  "keywords": [
    "browser",
    "configuration",
    "runtime-config",
    "speed-test",
    "validation"
  ],
  "homepage": "https://github.com/firemonster612/comet-speedtest/tree/main/packages/config#readme",
  "bugs": {
    "url": "https://github.com/firemonster612/comet-speedtest/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firemonster612/comet-speedtest.git",
    "directory": "packages/config"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "!dist/**/__tests__/**",
    "src",
    "!src/**/__tests__/**",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -b && node ../../scripts/fix-dist-imports.mjs dist",
    "prepack": "pnpm build && node ../../scripts/check-package-entries.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
