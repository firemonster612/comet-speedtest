{
  "name": "@lightspeed/config",
  "version": "0.1.0",
  "description": "Runtime config defaults, validation, normalization, loading, and export helpers for Lightspeed.",
  "keywords": [
    "browser",
    "configuration",
    "runtime-config",
    "speed-test",
    "validation"
  ],
  "license": "MIT",
  "files": [
    "README.md",
    "LICENSE",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "!dist/**/__tests__/**"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -b && node ../../scripts/fix-dist-imports.mjs dist",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
