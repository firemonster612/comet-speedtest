{
  "name": "@comet-speedtest/core",
  "version": "0.2.0",
  "description": "Browser-first speed-test engine, result records, diagnostics, and quality scoring.",
  "keywords": [
    "browser",
    "bufferbloat",
    "internet-speed-test",
    "latency",
    "network",
    "speed-test",
    "throughput"
  ],
  "homepage": "https://github.com/firemonster612/comet-speedtest/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/firemonster612/comet-speedtest/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firemonster612/comet-speedtest.git",
    "directory": "packages/core"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "!dist/**/__tests__/**",
    "src",
    "!src/**/__tests__/**",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -b && node ../../scripts/fix-dist-imports.mjs dist",
    "prepack": "pnpm --filter @comet-speedtest/config build && pnpm build && node ../../scripts/check-package-entries.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false"
  },
  "dependencies": {
    "@comet-speedtest/config": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
