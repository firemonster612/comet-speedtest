{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 88,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "experimentalSortPackageJson": true,
  "experimentalSortImports": true,
  "experimentalTailwindClassSorting": true,
  "ignorePatterns": [
    "dist",
    "coverage",
    "node_modules",
    "playwright-report",
    "test-results",
    ".impeccable",
    ".playwright-mcp",
    ".scratch",
    "DESIGN.md",
    "PRODUCT.md"
  ]
}
