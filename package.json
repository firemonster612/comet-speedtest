{
  "name": "comet-speedtest",
  "private": true,
  "description": "Browser-first speed test toolkit and deployable production app.",
  "homepage": "https://github.com/firemonster612/comet-speedtest#readme",
  "bugs": {
    "url": "https://github.com/firemonster612/comet-speedtest/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firemonster612/comet-speedtest.git"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @comet-speedtest/playground dev",
    "dev:prod": "pnpm --filter @comet-speedtest/production-app dev",
    "dev:playground": "pnpm --filter @comet-speedtest/playground dev",
    "build": "pnpm --filter @comet-speedtest/config build && pnpm --filter @comet-speedtest/core build && pnpm --filter @comet-speedtest/internal-ui build && pnpm --filter @comet-speedtest/production-app build && pnpm --filter @comet-speedtest/playground build && pnpm --filter @comet-speedtest/create-app build && pnpm --filter @comet-speedtest/production build",
    "lint": "oxlint 'apps/*/src' 'apps/*/vite.config.ts' 'apps/*/vitest.config.ts' 'internal/*/src' 'internal/*/vitest.config.ts' 'packages/*/src' 'packages/*/bin' 'packages/*/scripts' 'packages/*/test' 'packages/*/vitest.config.ts' 'scripts' 'tests/browser' playwright.config.ts oxlint.config.ts --ignore-pattern '**/dist/**' --ignore-pattern '**/dist-templates/**' --ignore-pattern '**/dist-app/**' --ignore-pattern '**/node_modules/**'",
    "lint:fix": "oxlint --fix 'apps/*/src' 'apps/*/vite.config.ts' 'apps/*/vitest.config.ts' 'internal/*/src' 'internal/*/vitest.config.ts' 'packages/*/src' 'packages/*/bin' 'packages/*/scripts' 'packages/*/test' 'packages/*/vitest.config.ts' 'scripts' 'tests/browser' playwright.config.ts oxlint.config.ts --ignore-pattern '**/dist/**' --ignore-pattern '**/dist-templates/**' --ignore-pattern '**/dist-app/**' --ignore-pattern '**/node_modules/**'",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.browser.json --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "pnpm -r test",
    "test:browser": "env -u FORCE_COLOR -u NO_COLOR playwright test",
    "test:packages": "node scripts/test-packages.mjs",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:browser && pnpm test:packages"
  },
  "dependencies": {
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "jsdom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.8.0"
}
